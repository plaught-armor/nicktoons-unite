	{MB_BACK | MB_PATTERN, 3}, {MB_BACK | MB_PATTERN, 3}, {MB_BACK | MB_PATTERN, 3}, {MB_BACK | MB_PATTERN, 3},
	{MB_BACK | MB_PATTERN, 3}, {MB_BACK | MB_PATTERN, 3}, {MB_BACK | MB_PATTERN, 3}, {MB_BACK | MB_PATTERN, 3},
	{MB_BI, 2}, {MB_BI, 2}, {MB_BI, 2}, {MB_BI, 2},
	{MB_BI, 2}, {MB_BI, 2}, {MB_BI, 2}, {MB_BI, 2},
	{MB_BI, 2}, {MB_BI, 2}, {MB_BI, 2}, {MB_BI, 2},
