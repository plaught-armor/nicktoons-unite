// MPEG-2 variable-length code tables for the IPU decoder. The values are
// the standard's (ISO/IEC 13818-2 tables B-1 to B-15), laid out as libmpeg2
// and PCSX2 index them.
package ee

@(private)
Ipu_Vlc :: struct {
	val: i8, // mode bits, increment, size, motion delta, pattern
	len: u8,
}

@(private)
Ipu_Dct :: struct {
	run, level, len: u8,
}

// Macroblock type bits.
@(private) MB_INTRA :: 1
@(private) MB_PATTERN :: 2
@(private) MB_BACK :: 4
@(private) MB_FWD :: 8
@(private) MB_QUANT :: 16
@(private) MB_INTERLACED :: 32
@(private) MC_FRAME :: 2 * 64

@(private)
MB_I := [2]Ipu_Vlc{{MB_INTRA | MB_QUANT, 2}, {MB_INTRA, 1}}

@(private)
MB_P := [32]Ipu_Vlc {
	{MB_INTRA | MB_QUANT, 6}, {MB_PATTERN | MB_QUANT, 5}, {MB_FWD | MB_PATTERN | MB_QUANT, 5}, {MB_INTRA, 5},
	{MB_FWD, 3}, {MB_FWD, 3}, {MB_FWD, 3}, {MB_FWD, 3},
	{MB_PATTERN, 2}, {MB_PATTERN, 2}, {MB_PATTERN, 2}, {MB_PATTERN, 2},
	{MB_PATTERN, 2}, {MB_PATTERN, 2}, {MB_PATTERN, 2}, {MB_PATTERN, 2},
	{MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1},
	{MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1},
	{MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1},
	{MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1}, {MB_FWD | MB_PATTERN, 1},
}

@(private) MB_BI :: MB_FWD | MB_BACK

@(private)
MB_B := [64]Ipu_Vlc {
	{0, 0}, {MB_INTRA | MB_QUANT, 6},
	{MB_BACK | MB_PATTERN | MB_QUANT, 6}, {MB_FWD | MB_PATTERN | MB_QUANT, 6},
	{MB_BI | MB_PATTERN | MB_QUANT, 5}, {MB_BI | MB_PATTERN | MB_QUANT, 5},
	{MB_INTRA, 5}, {MB_INTRA, 5},
	{MB_FWD, 4}, {MB_FWD, 4}, {MB_FWD, 4}, {MB_FWD, 4},
	{MB_FWD | MB_PATTERN, 4}, {MB_FWD | MB_PATTERN, 4}, {MB_FWD | MB_PATTERN, 4}, {MB_FWD | MB_PATTERN, 4},
