#version 460
// Local-to-local transfer, layer by layer.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PC {
	Words vram;
	uint sbp, sbw, spsm, dbp, dbw, dpsm, sx, sy, dx, dy, w, h, layers;
} pc;

void main() {
	uvec2 p = gl_GlobalInvocationID.xy;
	if (p.x >= pc.w || p.y >= pc.h) return;
	VR = pc.vram;
	for (uint l = 0u; l < pc.layers; l++) {
		LB = l * VRAM_WORDS;
		uint v = read_raw(pc.spsm, pc.sbp, pc.sbw, (pc.sx + p.x) & 2047u, (pc.sy + p.y) & 2047u);
		write_raw(pc.dpsm, pc.dbp, pc.dbw, (pc.dx + p.x) & 2047u, (pc.dy + p.y) & 2047u, v);
	}
}
