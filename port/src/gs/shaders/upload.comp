#version 460
// Host-to-local transfer: pixel values unpacked by the CPU, one word each,
// stored into every layer.
#include "common.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
	Words vram;
	Words data;
	uint psm, bp, bw, x0, y0, w, start, count, layers;
} pc;

void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= pc.count) return;
	VR = pc.vram;
	uint p = pc.start + i;
	uint x = (pc.x0 + p % pc.w) & 2047u;
	uint y = (pc.y0 + p / pc.w) & 2047u;
	uint v = pc.data.w[i];
	for (uint l = 0u; l < pc.layers; l++) {
		LB = l * VRAM_WORDS;
		write_raw(pc.psm, pc.bp, pc.bw, x, y, v);
	}
}
