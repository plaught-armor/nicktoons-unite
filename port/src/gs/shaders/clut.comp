#version 460
// CLUT load (../mem.odin `clut_load`): entries base..base+n of the
// persistent 512-entry CLUT come from native-resolution local memory, the
// rest keep their value. The whole table is then copied to `outp` for the
// primitives after this load; n = 0 only copies it.
#include "common.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
	Words vram, cur, outp;
	uint cpsm, cbp, cbw, cou, cov, csm2, n, base;
} pc;

void main() {
	uint i = gl_GlobalInvocationID.x;
	VR = pc.vram;
	LB = 0u;
	uint v = pc.cur.w[i];
	uint k = (i - pc.base) & 511u;
	if (k < pc.n) {
		uint x, y, bw = 1u;
		if (pc.csm2 != 0u) {
			x = pc.cou * 16u + k;
			y = pc.cov;
			bw = pc.cbw;
		} else if (pc.n == 256u) {
			uint p = (k & 0xe7u) | ((k & 0x08u) << 1) | ((k & 0x10u) >> 1);
			x = p & 15u;
			y = p >> 4;
		} else {
			x = k & 7u;
			y = k >> 3;
		}
		v = read_raw(pc.cpsm, pc.cbp, bw, x, y);
		pc.cur.w[i] = v;
	}
	pc.outp.w[i] = v;
}
