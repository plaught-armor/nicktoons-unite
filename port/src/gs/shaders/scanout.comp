#version 460
// Read circuit: the displayed buffer as RGBA8888 at scale x scale output
// pixels per GS pixel, each from its own layer.
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PC {
	Words vram;
	Words outp;
	uint psm, fbp, fbw, dbx, dby, w, h, scale;
} pc;

void main() {
	uvec2 p = gl_GlobalInvocationID.xy;
	if (p.x >= pc.w || p.y >= pc.h) return;
	VR = pc.vram;
	uint s = pc.scale;
	LB = ((p.y % s) * s + p.x % s) * VRAM_WORDS;
	uint c = read_raw(pc.psm, pc.fbp, pc.fbw, pc.dbx + p.x / s, pc.dby + p.y / s);
	if (pc.psm == PSMCT16 || pc.psm == PSMCT16S) {
		c = (c & 0x1fu) << 3 | (c & 0x3e0u) << 6 | (c & 0x7c00u) << 9;
	}
	pc.outp.w[p.y * pc.w + p.x] = c | 0xff000000u;
}
