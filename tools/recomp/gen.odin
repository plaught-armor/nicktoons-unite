// `gen` mode: split the program into packages and write them out.
//
// Packages hold consecutive functions up to PKG_INSNS instructions so each
// compiles as its own module. Every package has a `register` proc filling
// the runtime's call table; `rec/all.odin` (package rec) calls them all.
package recomp

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:strings"

PKG_INSNS :: 40_000

gen :: proc(prog: ^Program, out_dir: string) -> bool {
	// Assign packages.
	pkg_of: map[u32]int
	groups: [dynamic][dynamic]^Func
	append(&groups, make([dynamic]^Func))
	size := 0
	for f in prog.funcs {
		if size >= PKG_INSNS {
			append(&groups, make([dynamic]^Func))
			size = 0
		}
		append(&groups[len(groups) - 1], f)
		pkg_of[f.entry] = len(groups) - 1
		size += len(f.insns)
	}

	os.make_directory(out_dir)
	for g, n in groups {
		dir, _ := filepath.join({out_dir, fmt.tprintf("p%02d", n)})
		os.make_directory(dir)
		e := Emitter{prog = prog, pkg_of = &pkg_of, pkg = n}
		strings.builder_init(&e.sb)
		sb := &e.sb
		fmt.sbprintfln(sb, "// Generated by tools/recomp from SLUS_212.84. Do not edit.")
		fmt.sbprintfln(sb, "package p%02d\n", n)
		fmt.sbprintln(sb, "import \"base:intrinsics\"")
		fmt.sbprintln(sb, "import ee \"../../ee\"\n")
		fmt.sbprintln(sb, "_ :: intrinsics\n")
		fmt.sbprintln(sb, FAST_HELPERS)
		fmt.sbprintln(sb, "register :: proc() {")
		for f in g {
			fmt.sbprintfln(sb, "\tee.register(0x%08x, f_%08x)", f.entry, f.entry)
			for l in interior_entries(&e, f) {
				fmt.sbprintfln(sb, "\tee.register(0x%08x, proc() {{f_%08x_at(0x%08x)}})", l, f.entry, l)
			}
		}
		fmt.sbprintln(sb, "}\n")
		for f in g {
			emit_func(&e, f)
			free_all(context.temp_allocator)
		}
		path, _ := filepath.join({dir, "code.odin"})
		if err := os.write_entire_file(path, sb.buf[:]); err != nil {
			fmt.eprintln("cannot write", path, err)
			return false
		}
		strings.builder_destroy(sb)
	}

	sb := strings.builder_make()
	fmt.sbprintln(&sb, "// Generated by tools/recomp. Do not edit.")
	fmt.sbprintln(&sb, "package rec\n")
	for _, n in groups {
		fmt.sbprintfln(&sb, "import \"p%02d\"", n)
	}
	fmt.sbprintln(&sb, "import \"vu1\"")
	fmt.sbprintln(&sb, "\nregister_all :: proc() {")
	for _, n in groups {
		fmt.sbprintfln(&sb, "\tp%02d.register()", n)
	}
	fmt.sbprintln(&sb, "\tvu1.register()")
	fmt.sbprintln(&sb, "}")
	path, _ := filepath.join({out_dir, "all.odin"})
	if err := os.write_entire_file(path, sb.buf[:]); err != nil {
		fmt.eprintln("cannot write", path, err)
		return false
	}
	fmt.printfln("%d functions in %d packages -> %s", len(prog.funcs), len(groups), out_dir)
	return true
}

// Copies of the hottest ee helpers, emitted into every code.odin. Each file
// compiles as its own module, so a call into ee is never inlined, not even a
// #force_inline one. These inline RAM and scratchpad accesses and leave
// everything else to ee.
FAST_HELPERS :: `sx32 :: #force_inline proc "contextless" (v: u32) -> u64 {return u64(i64(i32(v)))}

fclamp :: #force_inline proc "contextless" (x: f32) -> f32 {
	u := transmute(u32)x
	switch u & 0x7f800000 {
	case 0x7f800000: return transmute(f32)((u & 0x80000000) | 0x7f7fffff)
	case 0:          return transmute(f32)(u & 0x80000000)
	}
	return x
}

// Host pointer for a plain RAM or scratchpad address, else nil.
@(private)
fast :: #force_inline proc "contextless" (a: u32) -> rawptr {
	if a < ee.fast_lim {return &ee.ram_base[a]}
	if a - ee.SPR_BASE < ee.SPR_SIZE {return &ee.spr[a - ee.SPR_BASE]}
	return nil
}

rd8 :: #force_inline proc(a: u32) -> u8 {p := fast(a); return p != nil ? (^u8)(p)^ : ee.rd8(a)}
rd16 :: #force_inline proc(a: u32) -> u16 {p := fast(a); return p != nil ? intrinsics.unaligned_load((^u16)(p)) : ee.rd16(a)}
rd32 :: #force_inline proc(a: u32) -> u32 {p := fast(a); return p != nil ? intrinsics.unaligned_load((^u32)(p)) : ee.rd32(a)}
rd64 :: #force_inline proc(a: u32) -> u64 {p := fast(a); return p != nil ? intrinsics.unaligned_load((^u64)(p)) : ee.rd64(a)}
rd128 :: #force_inline proc(a: u32) -> u128 {p := fast(a &~ 15); return p != nil ? intrinsics.unaligned_load((^u128)(p)) : ee.rd128(a)}

wr8 :: #force_inline proc(a: u32, v: u8) {if p := fast(a); p != nil {(^u8)(p)^ = v} else {ee.wr8(a, v)}}
wr16 :: #force_inline proc(a: u32, v: u16) {if p := fast(a); p != nil {intrinsics.unaligned_store((^u16)(p), v)} else {ee.wr16(a, v)}}
wr32 :: #force_inline proc(a: u32, v: u32) {if p := fast(a); p != nil {intrinsics.unaligned_store((^u32)(p), v)} else {ee.wr32(a, v)}}
wr64 :: #force_inline proc(a: u32, v: u64) {if p := fast(a); p != nil {intrinsics.unaligned_store((^u64)(p), v)} else {ee.wr64(a, v)}}
wr128 :: #force_inline proc(a: u32, v: u128) {if p := fast(a &~ 15); p != nil {intrinsics.unaligned_store((^u128)(p), v)} else {ee.wr128(a, v)}}
`
